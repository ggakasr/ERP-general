# Supabase (public — also set these on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres connection for scripts/db.mjs and tests only (never on Vercel, never commit)
# Supabase Dashboard → Project Settings → Database → Connection string (Session pooler)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional outer gate for public deployments (e.g. Vercel preview links shared broadly).
# When set, every route — including /login, which shows the shared demo password —
# requires this code first (see src/app/gate, src/app/api/gate, src/middleware.ts).
# Leave unset for local dev / trusted audiences: the gate is disabled by default.
# DEMO_GATE_CODE=choose-a-code
