# Supabase (public — also set these on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres connection for scripts/db.mjs and tests only (never on Vercel, never commit)
# Supabase Dashboard → Project Settings → Database → Connection string (Session pooler)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional outer gate for public deployments (e.g. Vercel preview links shared broadly).
# When set, every route — including /login, which shows the shared demo password —
# requires this code first (see src/app/gate, src/app/api/gate, src/middleware.ts).
# Leave unset for local dev / trusted audiences: the gate is disabled by default.
# DEMO_GATE_CODE=choose-a-code

# Optional real email delivery (src/app/api/notifications/flush). Every in-app
# notification is queued in email_outbox regardless; without RESEND_API_KEY it is
# marked SIMULATED instead of actually sent. Get a free key at https://resend.com.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM="ERP General <onboarding@resend.dev>"
# Set automatically by Vercel when you configure the cron job (vercel.json) — protects
# the flush endpoint so only the real cron (or requests you send it yourself) can trigger it.
# CRON_SECRET=choose-a-secret

# Service role key (server-side only — CSKH bot, demo signup; never expose to browser)
# Supabase Dashboard → Project Settings → API → service_role key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CSKH Bot (native, WP-K2). Default provider: mock (free, deterministic).
# Set ANTHROPIC_API_KEY to use Claude, or CSKH_OPENAI_API_KEY + CSKH_OPENAI_BASE_URL for DeepSeek/Gemini/OpenAI.
# CSKH_LLM_PROVIDER=mock
# CSKH_LLM_MODEL=mock
# ANTHROPIC_API_KEY=sk-ant-xxx
# CSKH_OPENAI_API_KEY=sk-xxx
# CSKH_OPENAI_BASE_URL=https://api.openai.com/v1
